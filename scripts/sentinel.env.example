# Settings for sentinel.sh and notify.sh. Copy to scripts/sentinel.env and fill in.
# It is sourced by bash: keep it KEY=value, and keep it out of git if it holds secrets
# (it should not: the token comes from a command, not from here).

# Telegram: the group (or chat) the owner reads, and the topic for system messages.
TELEGRAM_CHAT_ID=-1001234567890
SYSTEM_TOPIC=4                       # message_thread_id; empty for a chat without topics
# A command that prints the bot token. Examples:
#   TELEGRAM_TOKEN_CMD='cat /path/to/telegram_bot_token'
#   TELEGRAM_TOKEN_CMD='sudo -n vault-read "Telegram bot token"'
TELEGRAM_TOKEN_CMD='cat /etc/homelab/telegram_bot_token'

# Uptime Kuma (SQLite database, read only).
DOCKER='docker'                      # 'sudo -n docker' if the user needs root for Docker
KUMA_CONTAINER=uptime-kuma
KUMA_DB=/app/data/kuma.db

# The Claude Code session to wake: the newest local session whose name starts with this.
SESSION_PREFIX=homelab
CLAUDE_BIN=$HOME/.local/bin/claude
