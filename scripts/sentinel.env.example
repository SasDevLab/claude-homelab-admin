# Settings for sentinel.sh and notify.sh. Copy to scripts/sentinel.env and fill in.
# It is sourced by bash: keep it KEY=value, and keep it out of git if it holds secrets
# (it should not: the token comes from a command, not from here).

# Where notify.sh sends: telegram (default), ntfy, discord, slack, email, apprise.
# Every secret comes from a command that prints it (a file, your vault), never from here.
NOTIFY_VIA=telegram
SYSTEM_TOPIC=4                       # Telegram message_thread_id. Chat without topics, or another
                                     # channel: a word, such as system. It marks what wakes the session.

# telegram: the group (or chat) the owner reads, and a command that prints the bot token.
#   TELEGRAM_TOKEN_CMD='sudo -n vault-read "Telegram bot token"'
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_TOKEN_CMD='cat /etc/homelab/telegram_bot_token'

# ntfy: the topic URL. On ntfy.sh anyone who knows the topic reads it: make it long and random.
# NTFY_URL_CMD='cat /etc/homelab/ntfy_url'          # https://ntfy.sh/<long random topic>
# NTFY_TOKEN_CMD='cat /etc/homelab/ntfy_token'      # only for a server with access control

# discord: Channel settings > Integrations > Webhooks > Copy Webhook URL.
# DISCORD_WEBHOOK_CMD='cat /etc/homelab/discord_webhook'

# slack: an app with Incoming Webhooks, https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_CMD='cat /etc/homelab/slack_webhook'

# email: smtps:// (port 465) or smtp:// (STARTTLS, 587). TLS is required, except
# smtp://localhost for a relay on this machine (then SMTP_PASS_CMD can stay empty).
# SMTP_URL=smtps://smtp.example.com:465
# SMTP_USER=homelab@example.com
# SMTP_PASS_CMD='cat /etc/homelab/smtp_password'    # Gmail: an app password
# MAIL_FROM=homelab@example.com
# MAIL_TO=you@example.com
# NOTIFY_SUBJECT=homelab                            # the subject starts with this

# apprise: any other channel, https://github.com/caronc/apprise/wiki
# A command that prints the Apprise URL(s), one per line.
# Install it in a venv:  python3 -m venv ~/.local/share/apprise-venv
#                        ~/.local/share/apprise-venv/bin/pip install apprise
# APPRISE_URL_CMD='cat /etc/homelab/apprise_url'
# APPRISE_BIN=$HOME/.local/share/apprise-venv/bin/apprise   # default: apprise on PATH

# Uptime Kuma (SQLite database, read only).
DOCKER='docker'                      # 'sudo -n docker' if the user needs root for Docker
KUMA_CONTAINER=uptime-kuma
KUMA_DB=/app/data/kuma.db

# The Claude Code session to wake: the newest local session whose name starts with this.
SESSION_PREFIX=homelab
CLAUDE_BIN=$HOME/.local/bin/claude
